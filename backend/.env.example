# ── System under test ─────────────────────────────────────────────
# Eval-dedicated product instance. examples/azora/docker-compose.eval.yml exposes it on 8001;
# point at :8000 to test a plain dev instance instead.
PRODUCT_API_URL=http://localhost:8001

# Must match the EVAL_API_KEY configured in the system under test
EVAL_API_KEY=your-eval-key-here

# ── L2 judge (Agent-as-Judge via Claude Agent SDK) ────────────────
# Only needed when JUDGE_ENABLED=true. import / list / UI / human annotation work without it.
ANTHROPIC_API_KEY=sk-ant-...
# JUDGE_ENABLED=true

# Judge model — start with a capable one, then keep the cheapest that still agrees with
# human labels (validate_evaluator.py, see README).
# The default, anthropic/claude-haiku-5.5, is the OpenRouter id: set ANTHROPIC_BASE_URL
# (and ANTHROPIC_AUTH_TOKEN if the gateway wants it).
# With a plain Anthropic key, use the Anthropic id instead: GRADING_MODEL=claude-haiku-5-5
# GRADING_MODEL=anthropic/claude-haiku-5.5
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# GRADING_FALLBACK_MODEL=minimax/minimax-m2.7-highspeed   # used if GRADING_MODEL fails
# USER_SIMULATOR_MODEL=minimax/minimax-m2.7               # answers the agent's clarification questions
# JUDGE_PRESET=false                                       # true = judge gets Claude Code tools (slower, can verify online)
# LEGACY_L2_ENABLED=false                                  # true = also run the old 5 generic-dimension judge

# ── Other optional overrides ──────────────────────────────────────
# PASS_RULE=pass_all         # pass_all = every check passes; composite = weighted score ≥ PASS_THRESHOLD
# PASS_THRESHOLD=60          # composite rule only; should come from calibration, not guesswork
# PRODUCT_CODE_PATH=         # product source for preset-mode judge deep checks
# DB_PATH=./eval.db
# EVAL_PORT=8100
# EVAL_CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# ── Production trace import (scripts/export_langfuse.py) ─────────
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
